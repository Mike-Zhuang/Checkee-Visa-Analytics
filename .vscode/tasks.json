{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend: Run API",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "-m",
                "uvicorn",
                "app.main:app",
                "--reload",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Frontend: Run H5",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Dev: Full Stack",
            "dependsOn": [
                "Backend: Run API",
                "Frontend: Run H5"
            ],
            "dependsOrder": "parallel"
        }
    ]
}